ld: link programs at 0x60000000, where the OS/2 Warp ARM64 kernel runs
them (its user window, kernel/include/mmu.h), not at Linux's 0x400000.

--- binutils-2.44.orig/ld/emulparams/aarch64linux.sh	2026-11-13 15:45:56
+++ binutils-2.44/ld/emulparams/aarch64linux.sh	2026-11-13 15:45:56
@@ -22,7 +22,7 @@
 SEPARATE_GOTPLT=24
 IREL_IN_PLT=
 
-TEXT_START_ADDR=0x400000
+TEXT_START_ADDR=0x60000000
 
 DATA_START_SYMBOLS='PROVIDE (__data_start = .);';
 
