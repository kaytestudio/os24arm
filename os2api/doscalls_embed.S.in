/* os2api/doscalls_embed.S.in — generated by CMake (configure_file)
 *
 * Embeds a build-time copy of DOSCALLS.DLL into whatever this object is
 * linked into (CMD.EXE, KAYTEVM.EXE, ...), so os2_api_import_init()
 * (os2api/os2_api_import.c) can load it via the kernel's built-in DLL
 * loader (kernel/src/lx_dll_loader.c) without needing a populated disk
 * image. See the "DOSCALLS.DLL embedding" block in the top-level
 * CMakeLists.txt, which substitutes @DOSCALLS_DLL_PATH@ below.
 */

.section .rodata
.align 4
.global doscalls_dll_start
doscalls_dll_start:
.incbin "@DOSCALLS_DLL_PATH@"
.global doscalls_dll_end
doscalls_dll_end:
