# cmake/version.cmake - the build's version: os2warp_version.h (OUT), from
# git (SRC) and today's date. Run at every build (CMakeLists.txt,
# os2warp_version); the file is only rewritten when it changes, so nothing
# is recompiled for nothing.
execute_process(COMMAND git -C "${SRC}" describe --always --dirty --abbrev=7
                OUTPUT_VARIABLE REV OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT REV)
    set(REV "unknown")
endif()
string(TIMESTAMP DATE "%Y-%m-%d")
set(TEXT "/* generated by cmake/version.cmake */
#define OS2WARP_VERSION \"4.52\"
#define OS2WARP_REVISION \"${REV}\"
#define OS2WARP_BUILD_DATE \"${DATE}\"
")
if(EXISTS "${OUT}")
    file(READ "${OUT}" OLD)
endif()
if(NOT "${OLD}" STREQUAL "${TEXT}")
    file(WRITE "${OUT}" "${TEXT}")
endif()
